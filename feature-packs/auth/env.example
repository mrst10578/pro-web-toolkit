NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy Supabase projects may still expose an anon key.
# Use it only when the project does not have a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only keys are optional and must never be exposed to client code.
# SUPABASE_SERVICE_ROLE_KEY=
